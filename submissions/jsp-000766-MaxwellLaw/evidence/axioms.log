@Jsp000766.erdos_922 : ∀ {V : Type u_1} (G : SimpleGraph V) (k : ℕ),
  (∀ (S : Finset V), ∃ I ⊆ S, G.IsIndepSet ↑I ∧ S.card ≤ 2 * I.card + k) → G.chromaticNumber ≤ ↑(k + 2)
@Jsp000766.erdos_922_colorable : ∀ {V : Type u_1} (G : SimpleGraph V) (k : ℕ),
  (∀ (S : Finset V), ∃ I ⊆ S, G.IsIndepSet ↑I ∧ S.card ≤ 2 * I.card + k) → G.Colorable (k + 2)
@Jsp000766.erdos_922_of_finite_subgraphs : ∀ {V : Type u_1} (G : SimpleGraph V) (k : ℕ),
  Jsp000766.HasLargeIndependentSetsOnFiniteSubgraphs G k → G.Colorable (k + 2) ∧ G.chromaticNumber ≤ ↑(k + 2)
