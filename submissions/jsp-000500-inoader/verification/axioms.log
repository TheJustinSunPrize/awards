'JSP500.main_proven' depends on axioms: [propext, Classical.choice, Quot.sound]
'JSP500.upstream_proven' depends on axioms: [propext, Classical.choice, Quot.sound]
def JSP500.Main : Prop :=
∀ (c : Sym2 (Fin 50) → Fin 7), ∃ S, S.card = 8 ∧ ∃ k, JSP500.Misses c S k
def JSP500.Upstream : Prop :=
∀ (V : Type) [inst : Fintype V] [DecidableEq V],
  Fintype.card V = 50 → ∀ (c : Sym2 V → Fin 7), ∃ S, S.card = 8 ∧ ∃ k, JSP500.Misses c S k
JSP500.main_proven : JSP500.Main
JSP500.upstream_proven : JSP500.Upstream
