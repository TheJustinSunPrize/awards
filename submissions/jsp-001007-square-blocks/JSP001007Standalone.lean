/-- The primes in the half-open interval [q^2, (q+1)^2). -/
def primeBlock (q : ℕ) : Finset ℕ :=
  (Finset.Ico (q ^ 2) ((q + 1) ^ 2)).filter Nat.Prime

/-- The first square interval contains only 0, which is not prime. -/
@[simp]
