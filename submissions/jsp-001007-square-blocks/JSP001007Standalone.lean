#print axioms JSP001007.not_uniform_tenth_sieve
#print axioms JSP001007.not_erdos_uniform_sieve
#print axioms JSP001007.not_erdos_eventual_uniform_sieve
#print axioms JSP001007.fixed_1000_counterexample

end JSP001007

