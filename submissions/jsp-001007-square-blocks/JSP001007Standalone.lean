  decide

private noncomputable def blockWeight (q : ℕ) : ℝ :=
  ∑ p ∈ primeBlock q, (1 : ℝ) / p

private lemma blockWeight_nonneg (q : ℕ) : 0 ≤ blockWeight q := by
  exact Finset.sum_nonneg fun _ _ => by positivity

private lemma blockWeight_le (C q : ℕ)
