      (A : (i : Fin k) → Finset (ZMod (p i))),
      N0 ≤ N ∧
      (∀ i, (p i).Prime ∧ 2 < p i) ∧
      StrictMono p ∧
      (∀ i, (p i) ^ 10 < N ^ 9) ∧
      (∀ i, (A i).card = (p i) / 2) ∧
      N < 10 * (remaining N p A).card := by
