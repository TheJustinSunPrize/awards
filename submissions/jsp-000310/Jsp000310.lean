/-- Boolean checker: every certificate entry is a valid maximal run. -/
def certAllOk : Bool := cert.all fun (lo, hi, ps) => runOkB lo hi ps

theorem certAllOk_spec (h : certAllOk = true) :
    ∀ r ∈ cert, RunOk r.1 r.2.1 r.2.2 := by
  simp only [certAllOk, List.all_eq_true] at h
  exact fun r hr => runOkB_spec (h r hr)

/-- Linear coverage scan: starting from `x`, every integer up to `N` is
either prime or inside one of the intervals `cs`.  The fuel must exceed the
remaining length plus the number of intervals still to pop. -/
def coverOk (N : ℕ) : ℕ → ℕ → List (ℕ × ℕ) → Bool
  | 0, _, _ => true
  | fuel + 1, x, cs =>
    if N < x then true
    else match cs with
      | [] => isPrimeB x && coverOk N fuel (x + 1) []
      | (lo, hi) :: rest =>
        if x < lo then
          isPrimeB x && coverOk N fuel (x + 1) ((lo, hi) :: rest)
        else if x ≤ hi then
          !isPrimeB x && coverOk N fuel (x + 1) ((lo, hi) :: rest)
        else coverOk N fuel x rest

theorem coverOk_spec {N fuel x : ℕ} {cs : List (ℕ × ℕ)}
    (h : coverOk N fuel x cs = true) (hf : N + 1 - x + cs.length ≤ fuel) :
    ∀ m ∈ Finset.Icc x N, m.Prime ∨
      ∃ r ∈ cs, m ∈ Finset.Icc r.1 r.2 := by
  induction fuel generalizing x cs with
  | zero =>
    intro m hm
    rw [Finset.mem_Icc] at hm
    omega
  | succ fuel ih =>
    intro m hm
    rw [Finset.mem_Icc] at hm
    obtain ⟨hmx, hmN⟩ := hm
    rcases cs with _ | ⟨⟨lo, hi⟩, rest⟩
    · simp only [coverOk] at h
      split at h
      · omega
      · rw [Bool.and_eq_true] at h
        by_cases hxm : m = x
        · subst hxm; exact Or.inl (isPrimeB_true h.1)
        · exact ih h.2 (by omega) m (Finset.mem_Icc.mpr ⟨by omega, hmN⟩)
    · simp only [coverOk] at h
      split at h
      · omega
      · split at h
        · rw [Bool.and_eq_true] at h
          by_cases hxm : m = x
          · subst hxm; exact Or.inl (isPrimeB_true h.1)
          · exact ih h.2 (by omega) m (Finset.mem_Icc.mpr ⟨by omega, hmN⟩)
        · split at h
          · rw [Bool.and_eq_true] at h
            by_cases hxm : m = x
            · subst hxm
              exact Or.inr ⟨(lo, hi), List.mem_cons_self,
                Finset.mem_Icc.mpr ⟨by omega, by omega⟩⟩
            · exact ih h.2 (by omega) m (Finset.mem_Icc.mpr ⟨by omega, hmN⟩)
          · simp only [List.length_cons] at hf
            rcases ih h (by omega) m (Finset.mem_Icc.mpr ⟨hmx, hmN⟩) with
              hp | ⟨r, hrc, hrm⟩
            · exact Or.inl hp
            · exact Or.inr ⟨r, List.mem_cons_of_mem _ hrc, hrm⟩

/-- The intervals of the certificate. -/
def certIntervals : List (ℕ × ℕ) := cert.map fun (lo, hi, _) => (lo, hi)

/-- Coverage: every composite in `[2, CERT_N]` lies in a certificate run.
Verified by a linear kernel scan. -/
theorem cert_complete :
    ∀ m ∈ Finset.Icc 2 CERT_N, ¬ m.Prime →
      ∃ r ∈ cert, m ∈ Finset.Icc r.1 r.2.1 := by
  intro m hm hcomp
  have hm' := Finset.mem_Icc.mp hm
  have hcov : coverOk CERT_N (CERT_N + 1 + certIntervals.length) 2
      certIntervals = true := by
    decide
  have hc := coverOk_spec hcov (by simp [CERT_N]) m
    (Finset.mem_Icc.mpr ⟨hm'.1, hm'.2⟩)
  rcases hc with hp | ⟨r, hrc, hrm⟩
  · exact absurd hp hcomp
  · simp only [certIntervals, List.mem_map] at hrc
    obtain ⟨⟨lo, hi, ps⟩, hrmem, heq⟩ := hrc
    rw [← heq] at hrm
    exact ⟨⟨lo, hi, ps⟩, hrmem, hrm⟩

/-- Every certificate entry is a valid maximal run. -/
theorem cert_valid : ∀ r ∈ cert, RunOk r.1 r.2.1 r.2.2 := by
  apply certAllOk_spec
  decide

/-- Grimm's conjecture holds for every interval `[a, b] ⊆ [2, CERT_N]` whose
members are all composite.  The run containing `a` extends at least to `b`:
otherwise `hi + 1` would be a prime inside `[a, b]`. -/
theorem grimm_certified {a b : ℕ} (ha : 2 ≤ a) (hb : b ≤ CERT_N) (hab : a ≤ b)
    (hcomp : ∀ m ∈ Finset.Icc a b, ¬ m.Prime) :
    GrimmHolds a b := by
  obtain ⟨⟨lo, hi, ps⟩, hrmem, hrm⟩ :=
    cert_complete a (Finset.mem_Icc.mpr ⟨ha, le_trans hab hb⟩)
      (hcomp a (Finset.mem_Icc.mpr ⟨le_rfl, hab⟩))
  rw [Finset.mem_Icc] at hrm
  obtain ⟨_, _, hhi, hlen, hnodup, hass⟩ := cert_valid _ hrmem
  have hrm' : lo ≤ a ∧ a ≤ hi := hrm
  have hlen' : ps.length = hi + 1 - lo := hlen
  have hhi' : (hi + 1).Prime ∨ CERT_N ≤ hi := hhi
  have hbhi : b ≤ hi := by
    rcases hhi' with hp | hcap
    · by_contra hgt
      push Not at hgt
      exact hcomp (hi + 1) (Finset.mem_Icc.mpr ⟨by omega, by omega⟩) hp
    · omega
  refine ⟨(ps.drop (a - lo)).take (b + 1 - a), ?_, ?_, fun i => ?_⟩
  · rw [List.length_take, List.length_drop]
    omega
  · exact hnodup.sublist
      ((List.take_sublist _ _).trans (List.drop_sublist _ _))
  · have hilt : (i : ℕ) < b + 1 - a := by
      have := i.isLt
      simp only [List.length_take, List.length_drop] at this
      omega
    have hpd := hass ⟨a - lo + i, by show a - lo + i < ps.length; omega⟩
    have heq : ((ps.drop (a - lo)).take (b + 1 - a))[i] = ps[a - lo + (i : ℕ)] := by
      rw [Fin.getElem_fin, List.getElem_take, List.getElem_drop]
    rw [heq]
    obtain ⟨hp1, hp2⟩ := hpd
    have hp2' : (ps[a - lo + (i : ℕ)]) ∣ lo + (a - lo + (i : ℕ)) := hp2
    refine ⟨hp1, ?_⟩
    rwa [show lo + (a - lo + (i : ℕ)) = a + i by omega] at hp2'

/-- Unconditional length-2 case: two consecutive composites have distinct
prime divisors, since `gcd(m, m+1) = 1`. -/
theorem grimm_two {m : ℕ} (hm : 2 ≤ m) :
    ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ p ≠ q ∧ p ∣ m ∧ q ∣ m + 1 := by
  obtain ⟨p, hp, hpd⟩ := Nat.exists_prime_and_dvd (n := m) (by omega)
  obtain ⟨q, hq, hqd⟩ := Nat.exists_prime_and_dvd (n := m + 1) (by omega)
  refine ⟨p, q, hp, hq, ?_, hpd, hqd⟩
  rintro rfl
  have h1 : p ∣ 1 := by
    have := Nat.dvd_sub hqd hpd
    simpa using this
  exact hp.not_dvd_one h1

/-- The conjecture for intervals of length `≤ 2` inside the certified range
(subsumed by `grimm_certified`). -/
theorem grimm_certified_len2 {a : ℕ} (ha : 2 ≤ a) (hb : a + 1 ≤ CERT_N)
    (hcomp : ∀ m ∈ Finset.Icc a (a + 1), ¬ m.Prime) :
    GrimmHolds a (a + 1) :=
  grimm_certified ha hb (by omega) hcomp

