import Mathlib

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

/-!
# JSP-000310 · Grimm's conjecture (Erdős Problem #375, Guy B32)

Grimm's conjecture: if `n + 1, …, n + k` are all composite, then there are
distinct primes `p₁, …, p_k` with `p_i ∣ n + i`.

This file formalizes the conjecture as a predicate on intervals and proves:

* `grimm_certified` — the conjecture holds for **every** interval
  `[a, b] ⊆ [2, CERT_N]`, where `CERT_N = 10000`.  The proof uses an explicit
  machine-checked certificate: the list of maximal composite runs in
  `[2, CERT_N]`, each equipped with a valid distinct-prime assignment.
  Certificate validity and coverage are checked by `decide`
  (kernel reduction only).

* `grimm_two` — the unconditional length-2 case: any two consecutive
  composites have distinct prime divisors, since `gcd(m, m+1) = 1`.
  (Recorded as trivial on the problem page.)

The full conjecture (all `n`, all `k`) is open and is not claimed here.
-/

namespace Jsp000310

/-- The bound up to which Grimm's conjecture is certified. -/
def CERT_N : ℕ := 10000

/-- A distinct-prime assignment for the interval `[a, a + ps.length)`. -/
def ValidAssign (a : ℕ) (ps : List ℕ) : Prop :=
  ps.Nodup ∧ ∀ i : Fin ps.length, (ps[i]).Prime ∧ ps[i] ∣ a + i

/-- Grimm's conjecture for the interval `[a, b]`: distinct primes,
one dividing each member. -/
def GrimmHolds (a b : ℕ) : Prop :=
  ∃ ps : List ℕ, ps.length = b + 1 - a ∧ ValidAssign a ps

/-- Trial division engine.  `trialAux n f d` scans candidates
`d, d + 1, …, d + f - 1` and returns `false` on the first one that divides
`n` while its square is `≤ n`; `true` when the square bound or the fuel is
exhausted.  Structural recursion on the fuel keeps it kernel-reducible. -/
def trialAux (n : ℕ) : ℕ → ℕ → Bool
  | 0, _ => true
  | f + 1, d =>
    if d * d > n then true
    else if n % d = 0 then false else trialAux n f (d + 1)

/-- Kernel-fast primality test: `isPrimeB n = true ↔ n.Prime` whenever
`2 ≤ n`.  `decide (Nat.Prime n)` is too slow in the kernel for a
certificate of this size (its reduction is linear in `n`). -/
def isPrimeB (n : ℕ) : Bool := if 2 ≤ n then trialAux n n 2 else false

theorem trialAux_true {n f d : ℕ} (h : trialAux n f d = true) :
    ∀ d', d ≤ d' → d' < d + f → d' * d' ≤ n → ¬ d' ∣ n := by
  induction f generalizing d with
  | zero =>
    intro d' _ hd2 _
    omega
  | succ f ih =>
    intro d' hd1 hd2 hd3
    unfold trialAux at h
    split at h
    · rename_i hbig
      have h4 : d * d ≤ d' * d' := Nat.mul_le_mul hd1 hd1
      omega
    · split at h
      · simp at h
      · rename_i hbig hmod
        by_cases heq : d' = d
        · subst heq
          intro hdvd
          exact hmod (Nat.mod_eq_zero_of_dvd hdvd)
        · exact ih h d' (by omega) (by omega) hd3

theorem trialAux_false {n f d : ℕ} (h : trialAux n f d = false) :
    ∃ d', d ≤ d' ∧ d' < d + f ∧ d' * d' ≤ n ∧ d' ∣ n := by
  induction f generalizing d with
  | zero => simp [trialAux] at h
  | succ f ih =>
    unfold trialAux at h
    split at h
    · simp at h
    · split at h
      · rename_i hbig hmod
        exact ⟨d, le_rfl, by omega, by omega, Nat.dvd_of_mod_eq_zero hmod⟩
      · rename_i hbig hmod
        obtain ⟨d', hd1, hd2, hd3, hdvd⟩ := ih h
        exact ⟨d', by omega, by omega, hd3, hdvd⟩

theorem isPrimeB_true {n : ℕ} (h : isPrimeB n = true) : n.Prime := by
  unfold isPrimeB at h
  split at h
  · rename_i h2
    rw [Nat.prime_def_le_sqrt]
    refine ⟨h2, fun m hm2 hm => ?_⟩
    have h4 : m * m ≤ n := Nat.le_sqrt.mp hm
    have h5 : m ≤ m * m := by nlinarith
    exact trialAux_true h m hm2 (by omega) h4
  · simp at h

theorem isPrimeB_false {n : ℕ} (h : isPrimeB n = false) : ¬ n.Prime := by
  unfold isPrimeB at h
  split at h
  · rename_i h2
    obtain ⟨d, hd1, hd2, hd3, hdvd⟩ := trialAux_false h
    intro hp
    rcases hp.eq_one_or_self_of_dvd d hdvd with rfl | rfl
    · omega
    · nlinarith
  · rename_i h2
    intro hp
    exact h2 hp.two_le

/-- A certificate entry `(lo, hi, ps)` records a maximal composite run
`[lo, hi]` together with a valid assignment `ps`. -/
def RunOk (lo hi : ℕ) (ps : List ℕ) : Prop :=
  (∀ m ∈ Finset.Icc lo hi, ¬ m.Prime) ∧
  (lo ≤ 2 ∨ (lo - 1).Prime) ∧
  ((hi + 1).Prime ∨ CERT_N ≤ hi) ∧
  ps.length = hi + 1 - lo ∧
  ValidAssign lo ps

/-- Boolean checker for `RunOk`. -/
def runOkB (lo hi : ℕ) (ps : List ℕ) : Bool :=
  (List.range' lo (hi + 1 - lo)).all (fun m => !isPrimeB m) &&
  (decide (lo ≤ 2) || isPrimeB (lo - 1)) &&
  (isPrimeB (hi + 1) || decide (CERT_N ≤ hi)) &&
  (ps.length == hi + 1 - lo) &&
  decide ps.Nodup &&
  (List.finRange ps.length).all (fun i =>
    isPrimeB (ps[i]) && decide ((ps[i]) ∣ lo + i))

theorem runOkB_spec {lo hi : ℕ} {ps : List ℕ} (h : runOkB lo hi ps = true) :
    RunOk lo hi ps := by
  simp only [runOkB, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq,
    List.all_eq_true, Bool.or_eq_true] at h
  obtain ⟨hcomp, hlo⟩ := h.1.1.1.1
  have hhi := h.1.1.1.2
  have hlen := h.1.1.2
  have hnodup := h.1.2
  have hass := h.2
  have hcomp' : ∀ m ∈ Finset.Icc lo hi, ¬ m.Prime := by
    intro m hm
    rw [Finset.mem_Icc] at hm
    have hx := hcomp m ((List.mem_range').mpr ⟨m - lo, by omega, by omega⟩)
    exact isPrimeB_false (by simpa using hx)
  have hlo' : lo ≤ 2 ∨ (lo - 1).Prime := by
    rcases hlo with hll | hlp
    · exact Or.inl hll
    · exact Or.inr (isPrimeB_true hlp)
  have hhi' : (hi + 1).Prime ∨ CERT_N ≤ hi := by
    rcases hhi with hp | hcap
    · exact Or.inl (isPrimeB_true hp)
    · exact Or.inr hcap
  refine ⟨hcomp', hlo', hhi', hlen, hnodup, fun i =>
    ⟨isPrimeB_true (hass i (List.mem_finRange i)).1,
     (hass i (List.mem_finRange i)).2⟩⟩

