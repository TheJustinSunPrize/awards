def Erdos882Trial.HasPrimitiveSubsetSums : Finset ℕ → Prop :=
fun A => ∀ S ⊆ A, S.Nonempty → ∀ T ⊆ A, T.Nonempty → ∑ a ∈ S, a ∣ ∑ a ∈ T, a → ∑ a ∈ S, a = ∑ a ∈ T, a
def Erdos882Trial.Admissible : ℕ → Finset ℕ → Prop :=
fun n A => (∀ a ∈ A, 1 ≤ a ∧ a ≤ n) ∧ HasPrimitiveSubsetSums A
def Erdos882Trial.PrimitiveImageCondition : Finset ℕ → Prop :=
fun A =>
  have values := Finset.image (fun S => ∑ a ∈ S, a) ({S ∈ A.powerset | S.Nonempty});
  ∀ x ∈ values, ∀ y ∈ values, x ∣ y → x = y
@admissible_squared_bound : ∀ {n : ℕ} {A : Finset ℕ}, Admissible n A → 2 ≤ A.card → 4 ^ A.card ≤ 32 * A.card * n ^ 2
finite_bound_explicit : ∀ (n : ℕ),
  ∀ A ⊆ Finset.Icc 1 n,
    (∀ x ∈ Finset.image (fun S => ∑ a ∈ S, a) ({S ∈ A.powerset | S.Nonempty}),
        ∀ y ∈ Finset.image (fun S => ∑ a ∈ S, a) ({S ∈ A.powerset | S.Nonempty}), x ∣ y → x = y) →
      2 ≤ A.card → 4 ^ A.card ≤ 32 * A.card * n ^ 2
@maximumSize_refined_upper_bound : ∀ {n : ℕ},
  32 ≤ n → ↑(maximumSize n) ≤ Real.logb 2 ↑n + 1 / 2 * Real.logb 2 (Real.logb 2 ↑n) + 3
refined_upper_bound : ∃ C,
  ∀ᶠ (n : ℕ) in Filter.atTop, ↑(maximumSize n) ≤ Real.logb 2 ↑n + 1 / 2 * Real.logb 2 (Real.logb 2 ↑n) + C
def Erdos882Trial.admissibleFamily : ℕ → Finset (Finset ℕ) :=
fun n => Finset.filter (Admissible n) (Finset.Icc 1 n).powerset
def Erdos882Trial.maximumSize : ℕ → ℕ :=
fun n => (admissibleFamily n).sup Finset.card
maximumSize_definition_alignment : ∀ (n : ℕ),
  maximumSize n =
    {A ∈ (Finset.Icc 1 n).powerset |
          ∀ x ∈ Finset.image (fun S => ∑ a ∈ S, a) ({S ∈ A.powerset | S.Nonempty}),
            ∀ y ∈ Finset.image (fun S => ∑ a ∈ S, a) ({S ∈ A.powerset | S.Nonempty}), x ∣ y → x = y}.sup
      Finset.card
