info: Audit.lean:19:0: def Erdos882Trial.HasPrimitiveSubsetSums : Finset ℕ → Prop :=
fun A => ∀ S ⊆ A, S.Nonempty → ∀ T ⊆ A, T.Nonempty → ∑ a ∈ S, a ∣ ∑ a ∈ T, a → ∑ a ∈ S, a = ∑ a ∈ T, a
info: Audit.lean:20:0: def Erdos882Trial.Admissible : ℕ → Finset ℕ → Prop :=
fun n A => (∀ a ∈ A, 1 ≤ a ∧ a ≤ n) ∧ HasPrimitiveSubsetSums A
info: Audit.lean:21:0: def Erdos882Trial.PrimitiveImageCondition : Finset ℕ → Prop :=
fun A =>
  have values := Finset.image (fun S => ∑ a ∈ S, a) ({S ∈ A.powerset | S.Nonempty});
  ∀ x ∈ values, ∀ y ∈ values, x ∣ y → x = y
info: Audit.lean:22:0: @admissible_squared_bound : ∀ {n : ℕ} {A : Finset ℕ}, Admissible n A → 2 ≤ A.card → 4 ^ A.card ≤ 32 * A.card * n ^ 2
