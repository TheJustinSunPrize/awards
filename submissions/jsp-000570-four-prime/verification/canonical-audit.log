Erdos700.FourPrime.four_prime_exact : ∀ (P A B C : ℕ),
  1 ≤ A →
    3 * A ≤ B →
      10 * B ^ 2 ≤ C →
        100 * C ^ 5 ≤ P →
          Nat.Prime P →
            Nat.Prime (P + A) →
              Nat.Prime (P + B) →
                Nat.Prime (P + C) → Erdos700.f (P * (P + A) * (P + B) * (P + C)) = P * (P + A) * (P + B)
def Erdos700.f : ℕ → ℕ :=
fun n => sInf {m | ∃ k, 1 < k ∧ k ≤ n / 2 ∧ m = n.gcd (n.choose k)}
'Erdos700.FourPrime.four_prime_exact' depends on axioms: [propext, Classical.choice, Quot.sound]
