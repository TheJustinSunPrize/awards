theorem JSP000883.erdos_1063_better_upper : have n := fun k =>
  sInf {m | 2 * k ≤ m ∧ ∃ i0 < k, ¬m - i0 ∣ m.choose k ∧ ∀ i < k, i ≠ i0 → m - i ∣ m.choose k};
have upper_bound := fun k => ↑((Finset.Icc 1 (k - 1)).lcm id);
(fun k => ↑(n k)) =O[Filter.atTop] upper_bound ∧
  upper_bound =o[Filter.atTop] fun k => ↑k * ↑((Finset.Icc 1 (k - 1)).lcm id) :=
JSP000883.betterUpper
