theorem JSP404.small_cases_exact :
  And (Eq (JSP404.alpha (OfNat.ofNat 5)) (HDiv.hDiv (HMul.hMul (OfNat.ofNat 3) Real.pi) (OfNat.ofNat 5)))
    (forall {N : Nat},
    LE.le (OfNat.ofNat 6) N → LE.le N (OfNat.ofNat 8) → Eq (JSP404.alpha N)
      (HDiv.hDiv (HMul.hMul (OfNat.ofNat 2) Real.pi) (OfNat.ofNat 3))) :=
  _

def JSP404.alpha (a._@._internal._hyg.0 : Nat) : Real :=
  SupSet.sSup (Set.ofPred (fun (θ : Real) => JSP404.Guaranteed a._@._internal._hyg.0 θ))

def JSP404.Guaranteed (n : Nat) (a._@._internal._hyg.0 : Real) : Prop :=
  forall (s : Finset JSP404.Point), Eq (Finset.card s) n → JSP404.HasLargeAngle s a._@._internal._hyg.0

def JSP404.HasLargeAngle (s : Finset JSP404.Point) (a._@._internal._hyg.0 : Real) : Prop :=
  Exists
    (fun (a : JSP404.Point) =>
    And (Membership.mem s a)
      (Exists
        (fun (b : JSP404.Point) =>
        And (Membership.mem s b)
          (Exists
            (fun (c : JSP404.Point) =>
            And (Membership.mem s c)
              (And (Ne a b)
                (And (Ne a c) (And (Ne b c) (LE.le a._@._internal._hyg.0 (EuclideanGeometry.angle a b c))))))))))

