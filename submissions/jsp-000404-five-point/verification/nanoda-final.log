theorem SendovFivePointPlane.finite_set_large_angle (s : Finset SendovFivePointPlane.Point)
  (hs : LE.le (OfNat.ofNat 5) (Finset.card s)) :
  Exists
    (fun (a : SendovFivePointPlane.Point) =>
    And (Membership.mem s a)
      (Exists
        (fun (b : SendovFivePointPlane.Point) =>
        And (Membership.mem s b)
          (Exists
            (fun (c : SendovFivePointPlane.Point) =>
            And (Membership.mem s c)
              (And (Ne a b)
                (And (Ne a c)
                  (And (Ne b c)
                    (LE.le (HDiv.hDiv (HMul.hMul (OfNat.ofNat 3) Real.pi) (OfNat.ofNat 5))
                      (EuclideanGeometry.angle a b c)))))))))) :=
  _

def SendovFivePointPlane.Point : Type 0 := EuclideanSpace Real (Fin (OfNat.ofNat 2))

