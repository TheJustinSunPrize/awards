import ThreeGenerator

noncomputable section
namespace JSP791

def cutoff : ℝ := (172376211 : ℝ) / 40000000

def line (c : ℝ) : ℝ := (23051746100259 : ℝ) / 10000000000000 - ((31 : ℝ) / 100)*(cutoff-c)

lemma orientation_positive {c : ℝ} (hl : (43:ℝ)/10 ≤ c) (hu : c ≤ cutoff) :
    0 < (c+1)^7 - (c^4-1)^2 := by

  let x : ℝ := cutoff-c
  let d : ℝ := (376211 : ℝ) / 40000000

  have hx : 0 ≤ x := by dsimp [x]; linarith

  have hd : 0 ≤ d-x := by dsimp [d,x,cutoff] at *; linarith

  have hdpos : 0 < d := by norm_num [d]

  have identity : (c+1)^7 - (c^4-1)^2 =
    ((4482331428688276586144248531052074645787558410603884225132279519 : ℝ) / 401284068095729786587101382590223108011720481) * x^0 * (d-x)^8 +
    ((39763825238359579140093631662423213785253279133495195333144000000 : ℝ) / 401284068095729786587101382590223108011720481) * x^1 * (d-x)^7 +
    ((152789026886914965875971733782730037248267316812301088000000000000 : ℝ) / 401284068095729786587101382590223108011720481) * x^2 * (d-x)^6 +
    ((332704693288127111506382547161723668043868697472000000000000000000 : ℝ) / 401284068095729786587101382590223108011720481) * x^3 * (d-x)^5 +
    ((449658745502023979606635061272069488148480000000000000000000000000 : ℝ) / 401284068095729786587101382590223108011720481) * x^4 * (d-x)^4 +
    ((386645263530958422580029899357800448000000000000000000000000000000 : ℝ) / 401284068095729786587101382590223108011720481) * x^5 * (d-x)^3 +
    ((206729897160555244295529750528000000000000000000000000000000000000 : ℝ) / 401284068095729786587101382590223108011720481) * x^6 * (d-x)^2 +
    ((62881555378174537138176000000000000000000000000000000000000000000 : ℝ) / 401284068095729786587101382590223108011720481) * x^7 * (d-x)^1 +
    ((8335336457437184000000000000000000000000000000000000000000000000 : ℝ) / 401284068095729786587101382590223108011720481) * x^8 * (d-x)^0 := by
    dsimp [line,cutoff,x,d]
    ring

  rw [identity]
  by_cases hh : x = 0
  · simp only [hh]
    norm_num [d]

  · have hxp : 0 < x := lt_of_le_of_ne hx (Ne.symm hh)
    positivity

