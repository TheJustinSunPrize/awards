  Ne u v → LE.le (OfNat.ofNat 1)
    (abs
      (HSub.hSub (JSP791.monomial a a._@._internal._hyg.0 a._@._internal._hyg.0 u)
        (JSP791.monomial a a._@._internal._hyg.0 a._@._internal._hyg.0 v)))

def JSP791.monomial (a b c : Real) (u : Fin (OfNat.ofNat 3) → Nat) : Real :=
  HMul.hMul (HMul.hMul (HPow.hPow a (u (OfNat.ofNat 0))) (HPow.hPow b (u (OfNat.ofNat 1))))
    (HPow.hPow c (u (OfNat.ofNat 2)))

