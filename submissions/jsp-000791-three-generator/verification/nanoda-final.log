def JSP791.SequenceSeparated (a : Nat → Real) : Prop :=
  forall (u v : Finsupp Nat Nat),
  Ne u v → LE.le (OfNat.ofNat 1) (abs (HSub.hSub (JSP791.sequenceMonomial a u) (JSP791.sequenceMonomial a v)))

def JSP791.sequenceMonomial (a : Nat → Real) (u : Finsupp Nat Nat) : Real :=
  Finsupp.prod u (fun (i k : Nat) => HPow.hPow (a i) k)

def JSP791.Separated3 (a a._@._internal._hyg.0 a._@._internal._hyg.0 : Real) : Prop :=
