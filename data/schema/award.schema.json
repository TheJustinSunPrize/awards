{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/awards/award.schema.json",
  "title": "award",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "batch",
    "problem",
    "recipients",
    "verification",
    "conflicts",
    "status",
    "revocation",
    "decision"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "batch": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        {
          "type": "null"
        }
      ]
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "number",
        "title_en",
        "posed",
        "resolved"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "number": {
          "type": [
            "integer",
            "string"
          ]
        },
        "title_en": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "posed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "year",
            "basis",
            "citation"
          ],
          "properties": {
            "year": {
              "type": "integer",
              "minimum": 1
            },
            "basis": {
              "enum": [
                "stated",
                "scholarly-consensus",
                "earliest-reference"
              ]
            },
            "citation": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "resolved": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "year"
              ],
              "properties": {
                "year": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "affiliation",
          "contribution_en",
          "confirmation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*|RECIPIENT-[A-Za-z0-9-]+)$"
          },
          "affiliation": {
            "type": "string"
          },
          "contribution_en": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "confirmation": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/\\s]+(?:/[^\\s]*)?$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peer_review",
        "formal",
        "independent_review"
      ],
      "properties": {
        "peer_review": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "venue",
                "identifier",
                "checked_via"
              ],
              "properties": {
                "venue": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "identifier": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "checked_via": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "formal": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "record",
                "statement"
              ],
              "properties": {
                "record": {
                  "const": "verification/record.yaml"
                },
                "statement": {
                  "const": "verification/statement.yaml"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "independent_review": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reviewer",
                "relation_to_recipient",
                "conclusion",
                "source"
              ],
              "properties": {
                "reviewer": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "relation_to_recipient": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "conclusion": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://[^/\\s]+(?:/[^\\s]*)?$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "person",
          "role_here",
          "also_in",
          "relation",
          "effect"
        ],
        "properties": {
          "person": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "role_here": {
            "enum": [
              "recipient",
              "curator",
              "verifier",
              "independent-reviewer"
            ]
          },
          "also_in": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "relation": {
            "enum": [
              "co-author",
              "collaborator",
              "other"
            ]
          },
          "effect": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "draft",
        "under-verification",
        "pending-recipient-confirmation",
        "announced",
        "disputed",
        "paid",
        "revoked"
      ]
    },
    "revocation": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "trigger",
            "reason_en",
            "evidence",
            "failure_point"
          ],
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "trigger": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "reason_en": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/\\s]+(?:/[^\\s]*)?$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "failure_point": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "announcement"
          ],
          "properties": {
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "announcement": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/\\s]+(?:/[^\\s]*)?$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "announced",
              "disputed",
              "paid",
              "revoked"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "type": "object"
          },
          "recipients": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "decision": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "revoked"
          }
        }
      },
      "then": {
        "properties": {
          "revocation": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "revocation": {
            "type": "null"
          }
        }
      }
    }
  ]
}
