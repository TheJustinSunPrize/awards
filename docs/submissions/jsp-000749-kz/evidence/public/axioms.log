JSP000749.jsp000749_upper_bound (n : ℕ) (hn : 2 ≤ n) :
  ∃ H,
    JSP000749.Uniform H n ∧
      Finset.card H ≤ 4 * n ^ 2 * 2 ^ n ∧ JSP000749.ExactlyThree H ∧ ∀ G ⊂ H, JSP000749.Colorable G 2
JSP000749.m_upper_bound (n : ℕ) (hn : 2 ≤ n) : JSP000749.m n ≤ 4 * n ^ 2 * 2 ^ n
