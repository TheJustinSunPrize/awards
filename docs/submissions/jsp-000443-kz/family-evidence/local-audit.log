theorem JSP000443.c4StarRamsey_power_two : ∀ (r : ℕ),
  0 < r → JSP000443.c4StarRamsey ((2 ^ r) ^ 2) = (2 ^ r) ^ 2 + 2 ^ r + 1 :=
fun r hr =>
  let this := Fintype.ofFinite (GaloisField 2 r);
  have hc :=
    Eq.mpr (id (congrArg (fun _a => _a = 2 ^ r) (Eq.symm Nat.card_eq_fintype_card)))
      (GaloisField.card 2 r fun a => JSP000443.c4StarRamsey_power_two._proof_1_1 r hr a);
  have heven :=
    Eq.mpr (id (congrArg (fun _a => _a % 2 = 0) hc))
      (Exists.casesOn (Nat.exists_eq_succ_of_ne_zero fun a => JSP000443.c4StarRamsey_power_two._proof_1_1 r hr a)
        fun s h =>
        Eq.ndrec (motive := fun r =>
          0 < r →
            let this := Fintype.ofFinite (GaloisField 2 r);
            Fintype.card (GaloisField 2 r) = 2 ^ r → 2 ^ r % 2 = 0)
          (fun hr =>
            let this := Fintype.ofFinite (GaloisField 2 s.succ);
            fun hc =>
            of_eq_true
              (Eq.trans
                (congrFun'
                  (congrArg Eq
                    (Eq.trans (congrFun' (congrArg HMod.hMod (pow_succ 2 s)) 2) (Nat.mul_mod_left (2 ^ s) 2)))
                  0)
                (eq_self 0)))
          (Eq.symm h) hr hc);
  Eq.mp
    (congr (congrArg Eq (congrArg JSP000443.c4StarRamsey (congrFun' (congrArg HPow.hPow hc) 2)))
      (congrFun' (congrArg HAdd.hAdd (congr (congrArg HAdd.hAdd (congrFun' (congrArg HPow.hPow hc) 2)) hc)) 1))
    (JSP000443.PolarityFamily.exact_even (GaloisField 2 r) heven)
