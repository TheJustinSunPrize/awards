JSP000463.all_order_graphs (n : ℕ) (hn : 8 ≤ n) :
  ∃ G x, (SimpleGraph.cycleGraph 3).Free G ∧ (SimpleGraph.cycleGraph 4).Free G ∧ n ^ 3 < 512 * G.edgeFinset.card ^ 2
