JSP000554.badGap_iff_residue_all {p h : ℕ} (hh : 2 ≤ h) :
  JSP000554.BadGap p h ↔ h ≤ p ∧ Nat.Prime p ∧ Nat.Prime (p + h) ∧ p % JSP000554.primorial h ∈ JSP000554.omegaSet h
JSP000554.count_badGaps_all (s : Finset ℕ) (h : ℕ) (hh : 2 ≤ h) :
  {p ∈ s | JSP000554.BadGap p h}.card =
    ∑ b ∈ JSP000554.omegaSet h, {p ∈ s | h ≤ p ∧ Nat.Prime p ∧ Nat.Prime (p + h) ∧ p % JSP000554.primorial h = b}.card
JSP000554.gap_twelve_classification (p : ℕ) :
  JSP000554.BadGap p 12 ↔
    12 ≤ p ∧ Nat.Prime p ∧ Nat.Prime (p + 12) ∧ p % 2310 ∈ {1, 199, 467, 509, 1789, 1831, 2099, 2297}
