def JSP000554.BadGap : ℕ → ℕ → Prop :=
fun p h =>
  Nat.Prime p ∧
    Nat.Prime (p + h) ∧ (∀ (m : ℕ), p < m → m < p + h → ¬Nat.Prime m) ∧ ∀ (m : ℕ), p < m → m < p + h → m.minFac < h
def JSP000554.primorial : ℕ → ℕ :=
fun h => ∏ q ∈ Finset.range h with Nat.Prime q, q
def JSP000554.omegaSet : ℕ → Finset ℕ :=
fun h =>
  {b ∈ Finset.range (JSP000554.primorial h) |
    b.Coprime (JSP000554.primorial h) ∧
      (b + h).Coprime (JSP000554.primorial h) ∧ ∀ j ∈ Finset.Ioo 0 h, ¬(b + j).Coprime (JSP000554.primorial h)}
